generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductCondition {
  NEW
  USED
  SERVICE
}

enum FilterType {
  SELECT
  RANGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  image       String
  position    Int    @default(0)

  subcategories Subcategory[]
  products      Product[]
  filters       FilterOption[]
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]
  filters  FilterOption[]
}

model FilterOption {
  id      String     @id @default(cuid())
  key     String
  label   String
  type    FilterType @default(SELECT)
  options Json? // Храним массив { value: string, label: string } как JSON

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  title           String
  slug            String           @unique
  gost            String?
  price           Float?
  stock           Int              @default(0)
  condition       ProductCondition @default(NEW)
  images          String[]
  description     String?
  descriptionTags String?
  analogues       String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  specs      ProductSpec[]
  requests   Request[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductSpec {
  id    String  @id @default(cuid())
  value String
  unit  String?
  label String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  fullDescription String?
  features        String[]
  image           String?

  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  h1          String
  category    String
  image       String?
  body        String
  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

// Справочник нормативных документов (раздел «ГОСТы и нормативы», /normativ).
// Связь с товарами не хранится: её считает API по полю Product.gost (src/normativ/norm-code.ts).
model NormDocument {
  id           String    @id @default(cuid())
  slug         String    @unique
  code         String    @unique
  name         String
  kind         String
  status       String
  replacedBy   String?
  introducedAt String?
  scope        String
  sections     String[]  @default([])
  sourceUrl    String?
  sourceName   String?
  file         String?
  fileName     String?
  fileSize     Int?
  // Число страниц PDF и картинки первых страниц (/uploads/<uuid>.<ext>, по порядку) — «лист PDF» на странице документа.
  pageCount    Int?
  previews     String[]  @default([])
  title        String
  description  String
  h1           String
  body         String
  weight       String
  published    Boolean   @default(false)
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id              String  @id @default(cuid())
  name            String
  phone           String
  email           String?
  comment         String?
  policyAccepted  Boolean @default(false)
  requestFilePath String?
  partnerMapPath  String?

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  name           String
  phone          String
  email          String?
  address        String?
  comment        String?
  policyAccepted Boolean @default(false)

  status      OrderStatus @default(PENDING)
  totalAmount Float

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Float

  productTitle String
  productSku   String
  productSlug  String
  productImage String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String
  role         String   @default("admin")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  key       String   @id
  failures  Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum ChatSender {
  VISITOR
  MANAGER
}

model ChatConversation {
  id               String   @id @default(uuid())
  tokenHash        String   @unique
  visitorName      String
  contact          String?
  pageUrl          String?
  policyAcceptedAt DateTime
  expiresAt        DateTime
  closed           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  messages         ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id                 Int        @id @default(autoincrement())
  conversationId     String
  conversation       ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId           String
  sender             ChatSender
  body               String
  createdAt          DateTime   @default(now())
  readAt             DateTime?
  notificationSentAt DateTime?
  notificationDueAt  DateTime?
  notificationLockAt DateTime?
  notificationTries  Int        @default(0)

  @@unique([conversationId, sender, clientId])
  @@index([conversationId, id])
  @@index([conversationId, sender, readAt])
  @@index([notificationDueAt])
}
